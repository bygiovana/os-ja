# Copie para .env e ajuste. O arquivo .env não vai para o Git.

# Usado pelo docker compose
DB_SENHA=troque-esta-senha
PORT=3000

# Para rodar sem Docker (npm run dev), aponte para o seu Postgres:
DATABASE_URL=postgres://oficina:troque-esta-senha@localhost:5432/oficina

# Aparece no topo do sistema e no cabeçalho da OS impressa
OFICINA_NOME=Minha Oficina
OFICINA_DADOS=Rua Exemplo, 123 — Cidade/UF · (00) 0000-0000 · CNPJ 00.000.000/0001-00

# Login de acesso (recomendado). Deixe os dois vazios para desativar.
APP_USUARIO=
APP_SENHA=

# Fuso usado em "faturado no mês" e "atrasadas"
FUSO_HORARIO=America/Sao_Paulo
